{
  "version": "1",
  "quellen": {
    "pegel-messstellen": {
      "leser": "json-v1",
      "zeilen": "/result/records",
      "schema": "assets/schemas/messstellen.json",
      "optional": [
        "name",
        "gewaesser",
        "nummer",
        "standort",
        "pegelonline_url",
        "aktiv"
      ],
      "seiten": {
        "profil": "ckan-offset-v1",
        "groesse": 500,
        "maximum": 100
      }
    },
    "pegel-messwerte": {
      "leser": "json-v1",
      "zeilen": "/result/records",
      "schema": "assets/schemas/messwerte.json",
      "parameter": {
        "sort": "zeitstempel desc"
      },
      "seiten": {
        "profil": "ckan-offset-v1",
        "groesse": 500,
        "maximum": null
      }
    }
  }
}
